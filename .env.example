# ============================================================
# Incident Triage Agent — Environment Configuration
# Copy this file to .env and fill in values for your setup.
# Only the keys relevant to your chosen providers are required.
# ============================================================

# ── Provider selection ───────────────────────────────────────
# Embedding provider: openai | ollama | huggingface
EMBEDDING_PROVIDER=openai

# LLM provider: openai | anthropic | ollama
LLM_PROVIDER=openai

# ── OpenAI ───────────────────────────────────────────────────
# Required if EMBEDDING_PROVIDER=openai or LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...

# Models (defaults shown — override if needed)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_LLM_MODEL=gpt-4o

# ── Anthropic ────────────────────────────────────────────────
# Required if LLM_PROVIDER=anthropic
# Note: Anthropic does not offer an embeddings API.
#       Use openai, ollama, or huggingface for embeddings.
ANTHROPIC_API_KEY=sk-ant-...

# Model (defaults shown)
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ── Ollama (local) ───────────────────────────────────────────
# Required if EMBEDDING_PROVIDER=ollama or LLM_PROVIDER=ollama
# Ollama must be running: https://ollama.com
# Pull models first:  ollama pull all-minilm && ollama pull llama3.1
#
# OLLAMA_BASE_URL: leave unset when using Docker Compose — the compose file
# defaults to host.docker.internal:11434 which reaches Ollama on the host.
# Set explicitly only for non-Docker local dev or a remote Ollama instance:
# OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=all-minilm
OLLAMA_LLM_MODEL=llama3.1

# ── HuggingFace / local sentence-transformers ────────────────
# Required if EMBEDDING_PROVIDER=huggingface
# Model is downloaded from HuggingFace Hub on first run (~90MB for all-MiniLM-L6-v2).
# No API key needed. Set HF_HUB_OFFLINE=1 after initial download for air-gapped use.
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── ChromaDB ─────────────────────────────────────────────────
# Local persistent vector store. Directory is created automatically.
CHROMA_PERSIST_DIR=data/chroma_db
CHROMA_COLLECTION_NAME=runbooks

# ── Data paths ───────────────────────────────────────────────
RUNBOOKS_DIR=data/runbooks

# ── LangSmith observability ──────────────────────────────────
# Optional but highly recommended. Sign up at https://smith.langchain.com
# Set LANGCHAIN_TRACING_V2=true to enable tracing.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_PROJECT=incident-triage-agent
